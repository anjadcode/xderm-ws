 set_firewall () {
sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
if command -v nft >/dev/null 2>&1; then
  nft delete table inet xderm 2>/dev/null
  nft add table inet xderm 2>/dev/null
  nft 'add chain inet xderm postrouting { type nat hook postrouting priority srcnat; policy accept; }' 2>/dev/null
  nft 'add rule inet xderm postrouting oifname "tun0" masquerade' 2>/dev/null
  nft 'add chain inet xderm prerouting { type nat hook prerouting priority dstnat; policy accept; }' 2>/dev/null
  nft 'add rule inet xderm prerouting meta l4proto udp th dport 53 redirect to :53' 2>/dev/null
  nft 'add rule inet xderm prerouting meta l4proto tcp th dport 53 redirect to :53' 2>/dev/null
  nft 'add chain inet xderm forward { type filter hook forward priority filter; policy accept; }' 2>/dev/null
  nft 'add rule inet xderm forward oifname "tun0" accept' 2>/dev/null
  nft 'add rule inet xderm forward iifname "tun0" accept' 2>/dev/null
fi
if command -v iptables >/dev/null 2>&1; then
  iptables -t nat -A POSTROUTING -o tun0 -j MASQUERADE 2>/dev/null
  iptables -t nat -I PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 53 2>/dev/null
  iptables -t nat -I PREROUTING -p tcp --dport 53 -j REDIRECT --to-ports 53 2>/dev/null
  iptables -I FORWARD -o tun0 -j ACCEPT 2>/dev/null
  iptables -I FORWARD -i tun0 -j ACCEPT 2>/dev/null
fi
}
 flush_firewall () {
if command -v nft >/dev/null 2>&1; then
  nft delete table inet xderm 2>/dev/null
fi
if command -v iptables >/dev/null 2>&1; then
  iptables -t nat -D POSTROUTING -o tun0 -j MASQUERADE 2>/dev/null
  iptables -t nat -D PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 53 2>/dev/null
  iptables -t nat -D PREROUTING -p tcp --dport 53 -j REDIRECT --to-ports 53 2>/dev/null
  iptables -D FORWARD -o tun0 -j ACCEPT 2>/dev/null
  iptables -D FORWARD -i tun0 -j ACCEPT 2>/dev/null
fi
}
 routing () {
mode=$(cat /www/xderm/config/mode.default|sed 's/\.//g')
host=$(grep host= config.txt|awk -F "=" '{print $2}')
sni=$(grep sni= config.txt 2>/dev/null|awk -F "=" '{print $2}')
hostt=$(grep trojan:// /var/trojan2.txt|awk -F "://" '{print $2}'|awk -F "@" '{print $2}'|awk -F ":" '{print $1}'|awk "NR==1")
hostv=$(grep vmess: /var/vmess2.txt 2>/dev/null|awk -F "//" '{print $2}'|base64 -d 2>/dev/null|sed ':a;N;$!ba;s/\n  //g'|awk -F '"add' '{print $2}'|grep :|sed ':a;N;$!ba;s/\n/ /g'|awk -F ',' '{print $1}'|sed -e 's/://g' -e 's/ //g' -e 's/"//g')
  if [ "$mode" == "SSH" ] || [ "$mode" == "SSH-WS" ]; then
    if [ -f $host ]; then
     echo "Akun SSH belom disetting!" >> screenlog.0
     exit
    fi
  elif [ $mode == "Vmess" ]; then
    if [ -f $hostv ]; then
     echo "Akun vmess belom disetting!" >> screenlog.0
     exit
    fi     
elif [ $mode == "Trojan" ]; then 
    if [ -f $hostt ]; then
     echo "Akun trojan belom disetting!" >> screenlog.0
     exit
    fi
   elif [ $mode == "Multi" ]; then
    if [ -f $host ]; then
     echo "Akun SSH belom disetting!" >> screenlog.0
     exit
    fi
   fi
  wan_line=$(ip route show default 2>/dev/null | grep -v 'tun' | head -n1)
  ipg=$(echo "$wan_line" | awk '{print $3}')
  ifaces=$(echo "$wan_line" | awk '{print $5}')
  if [ -z "$ifaces" ]; then
    ifaces=$(ip r 2>/dev/null | grep default | grep -v 'tun' | awk '{print $3}' | head -n1)
  fi

  # Resolve all IPv4 addresses of CDN/Host/SNI for bulletproof anti-loop routing in Global Mode
  cdn_ips=$(python3 -c "
import socket
targets = ['$host', '$sni']
ips = set()
for t in targets:
    if t:
        try:
            for item in socket.getaddrinfo(t, 0, socket.AF_INET):
                ips.add(item[4][0])
        except Exception:
            pass
print(' '.join(ips))
" 2>/dev/null)
  if [ -z "$cdn_ips" ]; then
    cdn_ips="$host"
  fi

  for cip in $cdn_ips; do
    if [ -n "$ipg" ] && [ -n "$ifaces" ]; then
      ip route add $cip dev $ifaces via $ipg 2>/dev/null || ip route replace $cip dev $ifaces via $ipg 2>/dev/null
    elif [ -n "$ifaces" ]; then
      ip route add $cip dev $ifaces 2>/dev/null
    fi
  done
  for hip in $hostt $hostv 8.8.8.8; do
    if [ -n "$hip" ] && [ -n "$ipg" ] && [ -n "$ifaces" ]; then
      ip route add $hip dev $ifaces via $ipg 2>/dev/null || ip route replace $hip dev $ifaces via $ipg 2>/dev/null
    fi
  done

  if [ -n "$ipg" ] && [ -n "$ifaces" ]; then
    ip route replace default dev $ifaces via $ipg metric 10 2>/dev/null
  fi
 }

 jalankan_tun2socks () {
  local sport="$1"
  local pudp="${2:-7300}"
  local use_go="no"
  local gtun=$(cat /www/xderm/config/gotun 2>/dev/null)

  if [ "$gtun" == "yes" ] || ! command -v badvpn-tun2socks >/dev/null 2>&1; then
    use_go="yes"
  fi

  if [ "$use_go" == "yes" ]; then
    local gopath="go-tun2socks"
    if [ -x /www/xderm/go-tun2socks ]; then
      gopath="/www/xderm/go-tun2socks"
    elif [ -x /usr/bin/go-tun2socks ]; then
      gopath="/usr/bin/go-tun2socks"
    fi
    echo -e "{$(date +%M:%S)} Menjalankan go-tun2socks...." >> screenlog.0
    screen -dmS gerbang $gopath -loglevel none -proxyServer 127.0.0.1:$sport -proxyType socks -tunName tun0 -tunAddr 10.0.0.2 -tunGw 10.0.0.1 -tunMask 255.255.255.0
  else
    echo -e "{$(date +%M:%S)} Menjalankan badvpn-tun2socks...." >> screenlog.0
    screen -dmS gerbang badvpn-tun2socks --tundev tun0 --netif-ipaddr 10.0.0.2 --netif-netmask 255.255.255.0 --socks-server-addr 127.0.0.1:$sport --udpgw-remote-server-addr 127.0.0.1:$pudp --udpgw-transparent-dns --loglevel 0
  fi
  sleep 2

  ifconfig tun0 10.0.0.1 netmask 255.255.255.0 up 2>/dev/null || true
  ip addr add 10.0.0.1/24 dev tun0 2>/dev/null || true
  ip link set dev tun0 up 2>/dev/null || true
  if ip link show tun0 >/dev/null 2>&1; then
    echo -e "{$(date +%M:%S)} Routing Host, IP Gateway dan dns.." >> screenlog.0
    ip route replace default via 10.0.0.2 dev tun0 metric 1 onlink 2>/dev/null || ip route replace default via 10.0.0.2 dev tun0 metric 1 2>/dev/null || route add default gw 10.0.0.2 metric 1 2>/dev/null
  else
    echo -e "{$(date +%M:%S)} Gagal mengaktifkan tun0! Tetap menggunakan rute WAN fisik." >> screenlog.0
  fi
 }
